{
    "name": "functions",
    "scripts": {
        "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "eval": "ts-node -e \"require('./src/evals/runner').runEvals().then(({passed,failed,total,rate,failures})=>{console.log('Passed:',passed+'/'+total+'('+(rate*100).toFixed(1)+'%)');if(rate<0.9)process.exit(1);})\""
    },
    "engines": {
        "node": "20"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.95.1",
        "@google-cloud/text-to-speech": "^6.4.1",
        "@google/genai": "^0.8.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "axios": "^1.16.0",
        "firebase-admin": "^11.8.0",
        "firebase-functions": "^4.9.0",
        "googleapis": "^144.0.0",
        "resend": "^3.0.0",
        "stripe": "^14.19.0",
        "telegraf": "^4.15.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^18.19.130",
        "acorn": "^8.16.0",
        "firebase-functions-test": "^3.1.0",
        "typescript": "^5.3.3"
    },
    "private": true
}
