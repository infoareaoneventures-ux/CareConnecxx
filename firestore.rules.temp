rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // TEMPORARY: Allow authenticated users to read any user doc
    // This fixes the login hanging issue
    // TODO: Revert to stricter rules after fixing user documents
    match /users/{userId} {
      allow read: if isAuthenticated();  // TEMP: Allow any authenticated user
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Caregivers collection
    match /caregivers/{caregiverId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(caregiverId);
      allow update: if isOwner(caregiverId);
      allow delete: if false;
    }

    // Senior profiles
    match /senior_profiles/{profileId} {
      allow read: if isOwner(profileId);
      allow create: if isOwner(profileId);
      allow update: if isOwner(profileId);
      allow delete: if false;
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Job posts
    match /job_posts/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Threads
    match /threads/{threadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // Everything else - authenticated users can read/write for now
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
