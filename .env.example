# ── Linq (iMessage / RCS / SMS infrastructure) ────────────────────────────────
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3

# Frontend Linq vars (exposed to browser via Vite)
VITE_LINQ_PHONE_NUMBER=
VITE_SUPPORT_PHONE=
VITE_APP_URL=https://app.careconnecxx.com

# ── App / Agent ────────────────────────────────────────────────────────────────
APP_URL=https://app.careconnecxx.com
JWT_SECRET=
FEATURE_REAL_WORLD_HEALTHCARE_ACTIONS=false

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Server-side only (functions/.env) — never expose client-side
# All AI calls go through the aiProxy Firebase Function; no VITE_ AI key needed
ANTHROPIC_API_KEY=

# ── Stripe Configuration ───────────────────────────────────────────────────────
# Get these from your Stripe Dashboard: https://dashboard.stripe.com

# Frontend (Public Key - starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend (Secret Key - starts with sk_) - Store in Firebase Functions Config
# firebase functions:config:set stripe.secret_key="sk_test_..."
# firebase functions:config:set stripe.webhook_secret="whsec_..."

# Stripe Price ID for $29.95/month client membership
VITE_STRIPE_PRICE_ID=price_1TO8D5L7Ss5iuUb73AQ3zHKO

# Stripe Price ID for $24.95/year caregiver membership (background check)
VITE_STRIPE_CAREGIVER_ANNUAL=price_1TO8L6L7Ss5iuUb7Vrbea2tg

# Cloud Functions env vars (set via `firebase functions:config:set` or .env in /functions):
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_MONTHLY=price_1TO8D5L7Ss5iuUb73AQ3zHKO
#   STRIPE_CAREGIVER_ANNUAL=price_1TO8L6L7Ss5iuUb7Vrbea2tg

# Checkr Background Checks
# Cloud Functions env vars (set via `firebase functions:secrets:set` or .env in /functions):
#   CHECKR_API_KEY=<production API key from Checkr dashboard>
#   CHECKR_WEBHOOK_SECRET=<webhook signing secret from Checkr dashboard>
# Webhook URL to register in Checkr dashboard → Account → Webhooks:
#   https://<region>-<project>.cloudfunctions.net/checkrWebhook

# Sentry (error monitoring) — leave empty in dev, set in production .env
# Get the DSN from Sentry dashboard: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
# Optional: tag every event with the deployed git SHA / version string
VITE_RELEASE_VERSION=

# Other API Keys (to be configured)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_STORAGE_BUCKET=...
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...
