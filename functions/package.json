{
    "name": "functions",
    "scripts": {
        "build": "node scripts/transpile.js",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "eval": "npx ts-node --transpile-only src/evals/runner.ts",
        "mcp:inspect": "npx @modelcontextprotocol/inspector node lib/mcp/server.js",
        "mcp:test": "npx @modelcontextprotocol/inspector --test lib/mcp/server.js"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.95.1",
        "@browserbasehq/sdk": "^2.11.0",
        "@browserbasehq/stagehand": "^3.4.0",
        "@getzep/zep-cloud": "^3.22.0",
        "@google-cloud/text-to-speech": "^6.4.1",
        "@google/genai": "^0.8.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "axios": "^1.16.0",
        "firebase-admin": "^11.11.1",
        "firebase-functions": "^5.1.1",
        "googleapis": "^144.0.0",
        "openai": "^6.39.0",
        "pdfkit": "^0.18.0",
        "playwright-core": "^1.60.0",
        "resend": "^3.0.0",
        "stripe": "^14.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^22.10.0",
        "@types/pdfkit": "^0.17.6",
        "acorn": "^8.16.0",
        "firebase-functions-test": "^3.1.0",
        "typescript": "^5.3.3"
    },
    "private": true
}
