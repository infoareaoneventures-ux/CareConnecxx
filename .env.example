# ── Private beta access gate ───────────────────────────────────────────────────
# Server-side only (functions/.env) — the real access code, checked by the
# verifySitePassword callable. Never VITE_-prefixed: a VITE_ var is compiled
# into the public JS bundle in plain text (this is what the old
# VITE_SITE_PASSWORD did — readable by anyone via devtools). Leave unset to
# disable the gate server-side (verifySitePassword becomes a no-op that always
# issues an access token).
SITE_PASSWORD=

# Frontend — public on/off switch only, carries no secret. Must be "true" to
# show the access-code screen at all; set alongside SITE_PASSWORD above.
VITE_SITE_PASSWORD_GATE_ENABLED=false

# ── Linq (iMessage / RCS / SMS infrastructure) ────────────────────────────────
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3

# Frontend Linq vars (exposed to browser via Vite)
VITE_LINQ_PHONE_NUMBER=
VITE_SUPPORT_PHONE=
VITE_APP_URL=https://app.careconnecxx.com

# ── App / Agent ────────────────────────────────────────────────────────────────
APP_URL=https://app.careconnecxx.com
JWT_SECRET=
FEATURE_REAL_WORLD_HEALTHCARE_ACTIONS=false

# ── Evia routing convergence (pilot) ────────────────────────────────────────────
# Comma-separated flow keys to SHADOW (run the MCP loop in parallel, side-effect-free,
# and record to routing_shadow for comparison). Empty = off for every flow.
# e.g. ROUTING_CONVERGENCE_SHADOW=reminder_management
ROUTING_CONVERGENCE_SHADOW=
# Comma-separated flow keys whose LIVE handling is flipped from the cascade to the
# MCP loop — set only AFTER a flow's shadow data shows parity. Empty = none flipped.
CONVERGENCE_FLIPPED=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Server-side only (functions/.env) — never expose client-side
# All AI calls go through the aiProxy Firebase Function; no VITE_ AI key needed
ANTHROPIC_API_KEY=

# ── Stripe Configuration ───────────────────────────────────────────────────────
# Get these from your Stripe Dashboard: https://dashboard.stripe.com

# Frontend (Public Key - starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend (Secret Key - starts with sk_) - Store in Firebase Functions Config
# firebase functions:config:set stripe.secret_key="sk_test_..."
# firebase functions:config:set stripe.webhook_secret="whsec_..."

# Stripe Price ID for $29.95/month client membership
VITE_STRIPE_PRICE_ID=price_1TO8D5L7Ss5iuUb73AQ3zHKO

# Stripe Price ID for $24.95/year caregiver membership (background check)
VITE_STRIPE_CAREGIVER_ANNUAL=price_1TO8L6L7Ss5iuUb7Vrbea2tg

# Cloud Functions env vars (set via `firebase functions:config:set` or .env in /functions):
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_MONTHLY=price_1TO8D5L7Ss5iuUb73AQ3zHKO
#   STRIPE_CAREGIVER_ANNUAL=price_1TO8L6L7Ss5iuUb7Vrbea2tg
#   STRIPE_MVR_PRICE_ID=price_...   # one-time price for the MVR (Approved Driver) add-on.
#                                   # REQUIRED for MVR: if unset, MVR is never offered/charged.

# Checkr Background Checks
# Cloud Functions env vars (set via `firebase functions:secrets:set` or .env in /functions):
#   CHECKR_API_KEY=<production API key from Checkr dashboard>
#   CHECKR_WEBHOOK_SECRET=<webhook signing secret from Checkr dashboard>
# Checkr package slugs (set via .env in /functions) — these three MUST be distinct:
#   CHECKR_PACKAGE=<criminal-only package slug>             # base background check
#   CHECKR_PACKAGE_MVR=<criminal + MVR package slug>        # signup-with-MVR (bundled)
#   CHECKR_PACKAGE_MVR_ONLY=<MVR-only package slug>         # standalone "add MVR later"
# NOTE: CHECKR_PACKAGE_MVR / CHECKR_PACKAGE_MVR_ONLY must NOT equal CHECKR_PACKAGE —
# otherwise a caregiver is charged for MVR but runs a non-MVR check.
# Webhook URL to register in Checkr dashboard → Account → Webhooks:
#   https://<region>-<project>.cloudfunctions.net/checkrWebhook

# Sentry (error monitoring) — leave empty in dev, set in production .env
# Get the DSN from Sentry dashboard: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
# Optional: tag every event with the deployed git SHA / version string
VITE_RELEASE_VERSION=

# Other API Keys (to be configured)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_STORAGE_BUCKET=...
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...
