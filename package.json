{
  "name": "careconnex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "eval": "cd functions && npx ts-node src/evals/runner.ts",
    "eval:onboarding": "vitest run functions/src/agents/qaAgent.onboarding.eval.test.ts",
    "canary:onboarding": "cd functions && npx ts-node src/agents/onboardingCanaryWatch.ts",
    "predeploy": "npm run eval",
    "deploy": "node scripts/deploy.mjs",
    "test": "vitest",
    "test:rules:childcare": "firebase emulators:exec --only firestore \"npx vitest run tests/firestoreRules.childcare.test.ts\"",
    "icons": "node scripts/generate-icons.cjs",
    "migrate:predictive": "node scripts/run-migration.mjs",
    "migrate:predictive:dry": "node --env-file=.env scripts/run-migration.mjs",
    "audit:indexes": "node scripts/audit-firestore-query-contracts.mjs",
    "audit:childcare-consumers": "node scripts/audit-childcare-consumers.mjs",
    "audit:childcare-app-check": "node scripts/audit-childcare-app-check.mjs",
    "audit:indexes:live": "node scripts/audit-firestore-query-contracts.mjs --live",
    "deploy:indexes:additive": "node scripts/deploy-firestore-additive-indexes.mjs",
    "childcare:deploy-plan": "node scripts/childcare-deploy-plan.mjs",
    "childcare:seed-pricing": "node scripts/seed-childcare-pricing.mjs",
    "childcare:seed-jurisdiction": "node scripts/seed-childcare-jurisdiction.mjs",
    "childcare:flags": "node scripts/seed-childcare-flags.mjs",
    "childcare:go-live-plan": "node scripts/childcare-go-live.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.50.0",
    "@stripe/stripe-js": "^9.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/qrcode": "^1.5.6",
    "dompurify": "^3.3.1",
    "firebase": "^10.8.0",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "firebase-admin": "^13.6.1",
    "firebase-tools": "^15.20.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.15"
  }
}
